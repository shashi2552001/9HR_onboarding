# GEMINI_API_KEY: Optional for AI features if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port (must be 3000 in preview).
PORT=3000

# SESSION_SECRET: Cryptographic secret for signing staff JWT/session tokens.
SESSION_SECRET="replace-with-strong-32-char-random-secret"

# DATA_DIR: Directory for persistent application data (outside public/).
DATA_DIR="./data"

# UPLOAD_DIR: Private directory for uploaded candidate documents (never inside public/).
UPLOAD_DIR="./private_uploads"

# Optional SMTP configuration for real email notifications.
# When omitted, the portal logs notifications and provides Copy Onboarding Link without faking email delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="onboarding@9hrindia.com"
